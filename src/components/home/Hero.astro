---
import Icon from './Icon.astro';
import Scene from './Scene.astro';
interface Props { install: string }
const { install } = Astro.props;
---
<section id="top" class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap">
    <h1>The decision record for AI coding agents.</h1>
    <p class="sub">mnema keeps the why behind your agents’ work, signed, in your repository, and hands it to every next session.</p>
    <div class="acts">
      <a class="btn primary" href="/docs/first-record/">Get started <Icon name="arrow" /></a>
      <a class="btn" href="/docs/">Read the docs</a>
    </div>
    <div class="install mono">
      <span><span class="prompt">$</span> <span id="install-line">{install}</span></span>
      <button type="button" data-copy={install} data-from="install-line" aria-label="Copy the install command">copy</button>
    </div>
    <Scene />
  </div>
</section>
