---
// The home page: the product page in the brand. Its words are written in the components of `src/components/home/`; the
// facts it shows (the hosts, the contributors, the commands, the verdict, the refusal of the session demo, the links) are
// read by the build from the checkout of the release tag and handed over in `src/generated/home.json`, so none of them is
// typed twice; its pictures are the brand's, drawn by the build (`build/the-mark.mjs`).
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../generated/palette.css';
import '../styles/home.css';
import home from '../generated/home.json';
import built from '../generated/the-build.json';
import Bar from '../components/home/Bar.astro';
import Contributors from '../components/home/Contributors.astro';
import Footer from '../components/home/Footer.astro';
import Four from '../components/home/Four.astro';
import Hero from '../components/home/Hero.astro';
import Hosts from '../components/home/Hosts.astro';
import Proves from '../components/home/Proves.astro';
import SessionDemo from '../components/home/SessionDemo.astro';
import Start from '../components/home/Start.astro';
import Steps from '../components/home/Steps.astro';
import { jsonLdOf, structuredDataOf } from '../../build/the-pages.mjs';

const title = 'mnema: the decision record for AI coding agents';
const site = (Astro.site ?? new URL('https://mnema.work/')).href;
const card = `${site}og.png`;
const facts = {
  name: 'mnema',
  owner: home.owner,
  description: home.description,
  version: home.version,
  license: 'Apache-2.0',
  repoUrl: home.links.github,
  homeUrl: site,
  npmUrl: home.links.npm,
  extensionId: home.install.extensionId,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={home.description} />
    <link rel="canonical" href={site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={site} />
    <meta property="og:locale" content="en" />
    <meta property="og:description" content={home.description} />
    <meta property="og:site_name" content="mnema" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={home.card.alt} />
    <meta name="twitter:image" content={card} />
    <meta name="twitter:image:alt" content={home.card.alt} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={jsonLdOf(structuredDataOf(facts))} />
  </head>
  <body class="home">
    <Bar github={home.links.github} install={home.install.binary} />
    <main id="main">
      <Hero />
      <Steps />
      <Four command={home.verdict.command} verdict={home.verdict.lines} failure={home.failure} hosts={home.hosts} />
      <SessionDemo refusal={home.refusal} />
      <Hosts hosts={home.hosts} ring={home.ring} />
      <Proves />
      <Start install={home.install} />
      <Contributors title={home.contributors.title} thanks={home.contributors.thanks} people={home.contributors.people} />
    </main>
    <Footer owners={home.owners} links={home.links} contact={home.contact} built={built} />

    <script>
      import { line, smooth, relative, f } from '../generated/field.mjs';
      import { frameOf, opennessAt } from '../../build/the-hero-field.mjs';

      // The copy button: the clipboard API inside the click, and, where the browser refuses it, the text selected so a
      // keystroke finishes the job.
      for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
        button.addEventListener('click', () => {
          const text = button.dataset.copy ?? '';
          const shown = document.getElementById(button.dataset.from ?? '');
          const select = () => {
            if (!shown) return false;
            const range = document.createRange();
            range.selectNodeContents(shown);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            return true;
          };
          const done = (words: string) => {
            button.textContent = words;
            setTimeout(() => (button.textContent = 'copy'), 2000);
          };
          if (navigator.clipboard?.writeText) {
            navigator.clipboard.writeText(text).then(
              () => done('copied'),
              () => done(select() ? 'selected' : 'copy'),
            );
          } else {
            done(select() ? 'selected' : 'copy');
          }
        });
      }

      // The hero. The build draws the field at rest into the page; this moves it, and only where the reader has not asked for
      // less motion: asked, no frame is computed and the pointer is not listened to. The eye follows the pointer, and blinks
      // on the brand's 9 s cycle (the lids of `eye.mjs`); the lines part round it, and round the pointer.
      const svg = document.getElementById('field') as SVGSVGElement | null;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      if (svg) {
        const lines = svg.querySelector('.field-lines') as SVGPathElement;
        const iris = svg.querySelector('.field-iris') as SVGEllipseElement;
        const dots = [...svg.querySelectorAll('.field-dot')] as SVGCircleElement[];
        const ring = svg.querySelector('.field-pointer') as SVGCircleElement;
        const brand = { line, smooth, relative, f };
        let pointer: [number, number, number] | null = null;
        let [W, H] = [0, 0];
        let paused = false;
        let seen = true;
        let running = false;
        let last = 0;
        const start = performance.now();
        const size = () => {
          const box = svg.getBoundingClientRect();
          [W, H] = [box.width, box.height];
          svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
          svg.setAttribute('preserveAspectRatio', 'none');
        };
        const draw = (now: number) => {
          const t = now - start;
          const frame = frameOf(brand, { W, H, t, open: opennessAt(t), pointer });
          lines.setAttribute('d', frame.d);
          for (const [name, value] of Object.entries(frame.iris)) iris.setAttribute(name, value as string);
          frame.dots.forEach((dot: { cx: string; cy: string; r: string }, i: number) => {
            for (const [name, value] of Object.entries(dot)) dots[i]?.setAttribute(name, value);
          });
          ring.toggleAttribute('hidden', frame.pointer === null);
          if (frame.pointer) for (const [name, value] of Object.entries(frame.pointer)) ring.setAttribute(name, value as string);
        };
        const tick = (now: number) => {
          if (reduced.matches || paused || !seen || document.hidden) {
            running = false;
            return;
          }
          requestAnimationFrame(tick);
          if (now - last < (W < 700 ? 60 : 33)) return;
          last = now;
          draw(now);
        };
        const kick = () => {
          if (running || reduced.matches || paused || !seen || document.hidden) return;
          running = true;
          requestAnimationFrame(tick);
        };
        let listening = false;
        const listen = () => {
          if (listening || reduced.matches) return;
          listening = true;
          size();
          addEventListener('resize', size);
          svg.addEventListener('pointermove', (event) => {
            const box = svg.getBoundingClientRect();
            pointer = [event.clientX - box.left, event.clientY - box.top, 36];
          });
          svg.addEventListener('pointerleave', () => (pointer = null));
          new IntersectionObserver((entries) => {
            seen = entries[0]?.isIntersecting ?? true;
            kick();
          }).observe(svg);
          document.addEventListener('visibilitychange', kick);
        };
        // The blinking eyes are SMIL, which a stylesheet does not stop: the button pauses them with the field.
        const button = document.querySelector<HTMLButtonElement>('button.motion');
        const apply = () => {
          for (const picture of document.querySelectorAll('svg')) {
            if (paused) picture.pauseAnimations?.();
            else picture.unpauseAnimations?.();
          }
          if (button) {
            button.textContent = paused ? 'Play motion' : 'Pause motion';
          }
          kick();
        };
        button?.addEventListener('click', () => {
          paused = !paused;
          apply();
        });
        reduced.addEventListener('change', () => {
          listen();
          kick();
        });
        listen();
        kick();
      }
    </script>
  </body>
</html>
