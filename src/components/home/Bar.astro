---
// The bar at the top: the brand's eye, which blinks (and is still where the reader asks for less motion), and its word.
import eye from '../../generated/eye-bar.svg?raw';
import word from '../../generated/word.svg?raw';
interface Props { github: string; install: string }
const { github, install } = Astro.props;
---
<a class="skip" href="#main">Skip to the content</a>
<header class="bar">
  <div class="bar-in">
    <a class="brand" href="#top" aria-label="mnema, top of the page"><Fragment set:html={eye} /><Fragment set:html={word} /></a>
    <nav aria-label="Main">
      <a class="hide-s" href="#how">How it works</a>
      <a class="hide-s" href="#hosts">Hosts</a>
      <a href="/docs/">Docs</a>
      <a class="hide-s" href={github}>GitHub</a>
    </nav>
    <a class="pill hide-s" href="#start"><b>$</b> {install}</a>
  </div>
</header>
