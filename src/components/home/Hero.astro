---
// The hero: the field of lines with the eye in it, drawn at rest by the build (`src/generated/hero.svg`) and moved by the
// page's script where the reader has not asked for less motion.
import field from '../../generated/hero.svg?raw';
---
<section id="top" class="hero">
  <Fragment set:html={field} />
  <div class="txt">
    <p class="mono">mnema · open source · Apache-2.0</p>
    <h1>The decision record for AI coding agents.</h1>
    <p class="sub">mnema keeps the why behind your agents’ work, signed, in your repository, and hands it to every next session.</p>
    <div class="row">
      <a class="btn" href="/docs/first-record/">Get started</a>
      <a class="pill" href="/docs/">Read the docs →</a>
    </div>
  </div>
  <button type="button" class="motion" aria-pressed="false">Pause motion</button>
</section>
