---
// The home page: the product page of direction B (ADR-245, ADR-246). Its words are written in the components of
// `src/components/home/`; the facts it shows (the counts, the hosts and their rungs, the commands, the verdict, the
// refusal of the session demo, the links) are read by the build from the checkout of the release tag and handed over
// in `src/generated/home.json`, so none of them is typed twice.
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '@fontsource/jetbrains-mono/latin-800.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '../generated/palette.css';
import '../styles/home.css';
import home from '../generated/home.json';
import built from '../generated/the-build.json';
import Bar from '../components/home/Bar.astro';
import Close from '../components/home/Close.astro';
import Footer from '../components/home/Footer.astro';
import Hero from '../components/home/Hero.astro';
import HostsStrip from '../components/home/HostsStrip.astro';
import Measured from '../components/home/Measured.astro';
import Section from '../components/home/Section.astro';
import SessionDemo from '../components/home/SessionDemo.astro';
import { jsonLdOf, structuredDataOf } from '../../build/the-pages.mjs';

const title = 'mnema: the decision record for AI coding agents';
const site = (Astro.site ?? new URL('https://mnema.work/')).href;
const card = `${site}og.png`;
const facts = {
  name: 'mnema',
  description: home.description,
  version: home.version,
  license: 'Apache-2.0',
  repoUrl: home.links.github,
  homeUrl: site,
  npmUrl: home.links.npm,
  extensionId: home.install.extensionId,
};

const sections = [
  { id: 'how', kind: 'record', title: 'Record the why', words: 'When a choice is settled, your agent records it with the reason and what it turned down. It counts once it is accepted.' },
  { kind: 'session', title: 'Every session starts with it', words: 'Each new session opens with the decisions in force. The next agent starts from what was settled, not from zero.' },
  { kind: 'rule', title: 'Rules meet the edit', words: 'Point a decision at a path. An agent’s edit there waits for a person, or is refused with the rule named. The shell is not stopped.' },
  { kind: 'check', title: 'Anyone can check it', words: 'Every event is signed and chained. mnema verify checks the record with no key and no network, and fails when one word was changed.' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={home.description} />
    <link rel="canonical" href={site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={site} />
    <meta property="og:locale" content="en" />
    <meta property="og:description" content={home.description} />
    <meta property="og:site_name" content="mnema" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={home.card.alt} />
    <meta name="twitter:image" content={card} />
    <meta name="twitter:image:alt" content={home.card.alt} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={jsonLdOf(structuredDataOf(facts))} />
  </head>
  <body class="home">
    <Bar github={home.links.github} />
    <main id="main">
      <Hero install={home.install.binary} />
      {sections.map((s, i) => (
        <Section id={'id' in s ? s.id : undefined} n={i + 1} kind={s.kind} title={s.title} reverse={i % 2 === 1} command={home.verdict.command} verdict={home.verdict.lines} failure={home.failure.lines}>{s.words}</Section>
      ))}
      <SessionDemo refusal={home.refusal} />
      <section class="proof">
        <HostsStrip hosts={home.hosts} rungs={home.rungs} />
        <Measured sessions={home.measured.sessions} followed={home.measured.followed} plugin={home.measured.plugin} cli={home.measured.cli} url={home.measuredUrl} />
      </section>
      <Close install={home.install} />
    </main>
    <Footer links={home.links} contact={home.contact} built={built} />

<script>
      // The copy button: the clipboard API inside the click, and, where the browser refuses it, the text selected so
      // a keystroke finishes the job.
      for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
        button.addEventListener('click', () => {
          const text = button.dataset.copy ?? '';
          const shown = document.getElementById(button.dataset.from ?? '');
          const select = () => {
            if (!shown) return false;
            const range = document.createRange();
            range.selectNodeContents(shown);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            return true;
          };
          const done = (words: string) => {
            button.textContent = words;
            setTimeout(() => (button.textContent = 'copy'), 2000);
          };
          if (navigator.clipboard?.writeText) {
            navigator.clipboard.writeText(text).then(
              () => done('copied'),
              () => done(select() ? 'selected' : 'copy'),
            );
          } else {
            done(select() ? 'selected' : 'copy');
          }
        });
      }

      // Change one word: the illustration flips between the two outputs the page holds, and says which is shown.
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-vfy] button')) {
        button.addEventListener('click', () => {
          const box = button.closest('[data-vfy]');
          const broken = box?.classList.toggle('broken') ?? false;
          button.textContent = broken ? 'Put the word back' : 'Change one word';
          button.setAttribute('aria-pressed', String(broken));
        });
      }

      // Replay: the demo's messages start again from the first.
      const replay = document.querySelector<HTMLButtonElement>('.chat .tb button');
      replay?.addEventListener('click', () => {
        const chat = replay.closest('.chat');
        chat?.classList.remove('play');
        void (chat as HTMLElement | null)?.offsetWidth;
        chat?.classList.add('play');
      });

      // The motion starts only where the reader has not asked for less: with it asked, the scenes stay at their last
      // frame, which is how the markup and the style write them.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const scene = document.querySelector<HTMLElement>('.scene');
        if (scene) {
          const steps = [1, 2, 3, 4].map((i) => scene.querySelector<HTMLElement>(`.st${i}`));
          const rail = document.querySelector<HTMLElement>('.rail b');
          let n = 0;
          scene.classList.add('run');
          const tick = () => {
            n = (n % 5) + 1;
            const shown = Math.min(n, 4);
            steps.forEach((step, i) => {
              step?.classList.toggle('on', i < shown);
              step?.classList.toggle('now', i === shown - 1 && n < 5);
            });
            if (rail) rail.style.width = `${shown * 25}%`;
          };
          tick();
          setInterval(tick, 2100);
        }
        if ('IntersectionObserver' in window) {
          const seen = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                const target = entry.target;
                const once = target.classList.contains('chat');
                if (entry.isIntersecting) {
                  target.classList.add('play', 'in');
                  if (once) seen.unobserve(target);
                } else if (!once) {
                  target.classList.remove('play');
                }
              }
            },
            { threshold: 0.25 },
          );
          for (const target of document.querySelectorAll('.ill, .chat')) seen.observe(target);
        }
      }
    </script>
  </body>
</html>
